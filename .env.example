# Required by /api/community-join (the "Join Internet Athi Community" signup).
# Server-side only — do NOT prefix these with VITE_, which would bundle them into the
# public frontend. Set the real values in the Vercel project's Environment Variables settings.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The Supabase project's "service_role" secret key (Project Settings > API).
# This key bypasses Row Level Security — it must only ever be used server-side.
SUPABASE_SERVICE_ROLE_KEY=
